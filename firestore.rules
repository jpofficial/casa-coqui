rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // Helper functions
    // -------------------------------------------------------------------------

    // Returns true if the requester is signed in at all.
    function isAuthenticated() {
      return request.auth != null;
    }

    // Returns true if the signed-in user is the admin (matched by email).
    // Admin also carries the custom claim { role: "admin" } for extra safety.
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == '01juliop@gmail.com' ||
        request.auth.token.role == 'admin'
      );
    }

    // Returns true if the signed-in user is a staff member (admin, cohost, cleaner, maintenance).
    function isStaff() {
      return isAuthenticated() &&
        request.auth.token.role in ['admin', 'cohost', 'cleaner', 'maintenance'];
    }

    // Returns true if the signed-in uid matches the guest doc id.
    function isOwnerGuest(guestId) {
      return isAuthenticated() && request.auth.uid == guestId;
    }

    // -------------------------------------------------------------------------
    // users
    // Each authenticated user can read their own doc (needed for role lookup).
    // Only admin can write (invites, role changes).
    // -------------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      // Staff can update their own status (e.g. pending → active on first login)
      // and mark onboarding complete
      allow update: if isAuthenticated() && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'onboardingComplete']);
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // bookings
    // Admin has full access. Any authenticated user can read bookings.
    // Guest access is gated by phone verification (Firebase Phone Auth) and
    // the booking code itself is a secret nanoid in the URL.
    // -------------------------------------------------------------------------
    match /bookings/{bookingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // guests
    // Admin has full access. Each guest can only read/write their own document
    // (the doc ID is derived from their phone number in the confirm route).
    // -------------------------------------------------------------------------
    match /guests/{guestId} {
      allow read, write: if isAdmin() || isOwnerGuest(guestId);
    }

    // -------------------------------------------------------------------------
    // otps
    // No client access whatsoever — all reads and writes happen server-side
    // via the Admin SDK which bypasses these rules.
    // -------------------------------------------------------------------------
    match /otps/{otpId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // notifications
    // Staff has full read. Guests can read broadcasts, notifications addressed
    // to their guestId, or notifications targeting their bookingCode (direct,
    // push types). Guests can update ONLY the readBy field (mark-as-read).
    // -------------------------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isStaff() ||
        (isAuthenticated() && (
          resource.data.broadcast == true ||
          resource.data.type in ['broadcast', 'parking', 'general', 'maintenance', 'community', 'direct', 'push'] ||
          resource.data.guestId == request.auth.uid ||
          resource.data.bookingCode == request.auth.token.bookingCode
        ));
      allow create: if isStaff();
      allow update: if isAdmin() ||
        (isAuthenticated() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']));
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // messages
    // Admin has full access. Guests can read/create messages for their own
    // booking (matched by bookingCode custom claim on their auth token).
    // -------------------------------------------------------------------------
    match /messages/{messageId} {
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.bookingCode == request.auth.token.bookingCode);
      allow create: if isStaff() ||
        (isAuthenticated() && request.resource.data.bookingCode == request.auth.token.bookingCode);
      allow update: if isStaff();
    }

    // -------------------------------------------------------------------------
    // parking_reports
    // Any authenticated guest can create a parking report.
    // Admin can read all reports.
    // -------------------------------------------------------------------------
    match /parking_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
    }

    // -------------------------------------------------------------------------
    // expenses — admin only
    // -------------------------------------------------------------------------
    match /expenses/{expenseId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // supplies — admin only
    // -------------------------------------------------------------------------
    match /supplies/{supplyId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // receipts — admin only
    // -------------------------------------------------------------------------
    match /receipts/{receiptId} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // revenue — admin and staff can read, only admin can write
    // -------------------------------------------------------------------------
    match /revenue/{revenueId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // maintenance
    // Staff has full read access. Guests can create new requests and read only
    // the requests they created (matched by the guestId field on the document).
    // -------------------------------------------------------------------------
    match /maintenance/{requestId} {
      allow read: if isStaff() ||
        (isAuthenticated() && resource.data.guestId == request.auth.uid);
      allow create: if isAuthenticated() &&
        request.resource.data.guestId == request.auth.uid;
      allow update: if isAdmin() || (
        isStaff() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'notes', 'estimatedTime', 'guestResponse',
                    'respondedAt', 'respondedBy', 'acknowledgedAt', 'acknowledgedBy', 'updatedAt'])
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // laundry
    // Any authenticated user can read machine status.
    // No direct client writes — all mutations go through API routes which use
    // the Admin SDK. This enforces session ownership, timer logic, and
    // concurrency control server-side.
    // -------------------------------------------------------------------------
    match /laundry/{machineId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // laundry_sessions
    // Any authenticated user can read (needed for UI to show session info).
    // No direct client writes — all mutations via API (Admin SDK).
    // -------------------------------------------------------------------------
    match /laundry_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // laundry_waitlist
    // Guests can read their own waitlist entries.
    // No direct client writes — all mutations via API (Admin SDK).
    // -------------------------------------------------------------------------
    match /laundry_waitlist/{entryId} {
      allow read: if isAuthenticated() &&
        resource.data.guestId == request.auth.uid;
      allow write: if false;
    }

    // -------------------------------------------------------------------------
    // checkins
    // Admin has full access. Guests can create/update their own check-in
    // (doc ID is the booking code).
    // -------------------------------------------------------------------------
    match /checkins/{code} {
      allow read: if isAdmin() ||
        (isAuthenticated() && code == request.auth.token.bookingCode);
      allow write: if isAdmin() ||
        (isAuthenticated() && code == request.auth.token.bookingCode);
    }

    // -------------------------------------------------------------------------
    // fcm_tokens
    // Any authenticated user can create a token doc (doc ID must equal the
    // token field). Update/delete are scoped to the owner's identity.
    // Admin can read all for server-side queries.
    // -------------------------------------------------------------------------
    match /fcm_tokens/{tokenId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.staffId == request.auth.uid) ||
        (isAuthenticated() && resource.data.bookingCode == request.auth.token.bookingCode);
      allow create: if isAuthenticated() &&
        request.resource.data.token == tokenId &&
        (!('bookingCode' in request.resource.data) ||
          request.resource.data.bookingCode == request.auth.token.bookingCode) &&
        (!('staffId' in request.resource.data) ||
          request.resource.data.staffId == request.auth.uid);
      allow update: if isAuthenticated() &&
        (resource.data.bookingCode == request.auth.token.bookingCode ||
         resource.data.staffId == request.auth.uid);
      allow delete: if isAdmin() ||
        (isAuthenticated() &&
          (resource.data.bookingCode == request.auth.token.bookingCode ||
           resource.data.staffId == request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // notification_prefs
    // Each guest can read/write their own preferences (keyed by bookingCode).
    // Admin can read all.
    // -------------------------------------------------------------------------
    match /notification_prefs/{code} {
      allow read, write: if isAuthenticated() && code == request.auth.token.bookingCode;
      allow read: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // community
    // Any authenticated user can read. Admin can write.
    // Guests can create posts.
    // -------------------------------------------------------------------------
    match /community/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();

      match /replies/{replyId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated();
        allow update, delete: if isAdmin();
      }
    }

    // -------------------------------------------------------------------------
    // cleanings
    // Staff can read and write. Guests have no access.
    // -------------------------------------------------------------------------
    match /cleanings/{cleaningId} {
      allow read, write: if isStaff();
    }

    // -------------------------------------------------------------------------
    // supply_requests
    // Staff can read and write. Guests have no access.
    // -------------------------------------------------------------------------
    match /supply_requests/{requestId} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // assignments (admin-assigned tasks + auto-created maintenance tasks)
    // Admin has full access. Staff can read all and update allowed fields
    // on their own assignments or maintenance-sourced tasks.
    // -------------------------------------------------------------------------
    match /assignments/{assignmentId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isStaff() &&
        (resource.data.assigneeId == request.auth.uid || resource.data.assigneeId == null) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'completionNote', 'completedAt', 'updatedAt',
                    'guestResponse', 'estimatedTime', 'respondedAt', 'respondedBy',
                    'assigneeId', 'assigneeName', 'assigneeRole'])
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // cleaning_jobs (structured cleaning workflow)
    // Admin has full access. Assigned cleaner can read and update own jobs.
    // -------------------------------------------------------------------------
    match /cleaning_jobs/{jobId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isStaff() && resource.data.assigneeId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // staff_notifications
    // Each staff member can read/update their own notifications.
    // Staff and admin can create. No one can delete.
    // -------------------------------------------------------------------------
    match /staff_notifications/{notifId} {
      allow read: if isStaff() && resource.data.recipientId == request.auth.uid;
      allow create: if isStaff();
      allow update: if isStaff() && resource.data.recipientId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if false;
    }

    // -------------------------------------------------------------------------
    // booking_members
    // Any authenticated user can read (same model as bookings — the booking
    // code in the URL is the access gate). Any authenticated user can
    // create/update. Only admin can delete.
    // -------------------------------------------------------------------------
    match /booking_members/{memberId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // invite_tokens
    // Server-side only (Admin SDK). No client access.
    // -------------------------------------------------------------------------
    match /invite_tokens/{tokenId} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // settings
    // Admin can read and write. Any authenticated user can read (guests need
    // WiFi password, property name, etc.).
    // -------------------------------------------------------------------------
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

  }
}
