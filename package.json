{
  "name": "casa-coqui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-prompt-drift.js --quiet && node scripts/sync-shared.js --check --quiet",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test": "npm run check:shared && npm run test:lib && npm run test:functions && npm run test:lambda && npm run test:sam",
    "test:lib": "TZ=America/Puerto_Rico node --test lib/__tests__/*.test.js",
    "test:functions": "npm test --prefix functions",
    "test:lambda": "npm test --prefix infra/lambda/parse-airbnb-email",
    "test:sam": "npm test --prefix infra/sam/reply-agent",
    "test:infra": "cd infra && python3 -m pytest tests -q",
    "install:all": "npm ci && npm ci --prefix functions && npm ci --prefix infra/lambda/parse-airbnb-email && npm ci --prefix infra/sam/reply-agent && npm ci --prefix infra/sam/reply-agent/functions/reasoner && npm ci --prefix infra/sam/reply-agent/functions/write-back",
    "check:prompt-drift": "node scripts/check-prompt-drift.js",
    "sync:shared": "node scripts/sync-shared.js",
    "check:shared": "node scripts/sync-shared.js --check"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@aws-sdk/client-dynamodb": "^3.1045.0",
    "@aws-sdk/client-s3": "^3.1038.0",
    "@aws-sdk/client-sfn": "^3.1045.0",
    "@aws-sdk/lib-dynamodb": "^3.1045.0",
    "better-sqlite3": "^12.8.0",
    "cheerio": "^1.2.0",
    "firebase": "^12.10.0",
    "firebase-admin": "^13.7.0",
    "framer-motion": "^12.38.0",
    "nanoid": "^3.3.11",
    "next": "14.2.35",
    "next-pwa": "^5.6.0",
    "node-ical": "^0.26.0",
    "react": "^18",
    "react-dom": "^18",
    "recharts": "^3.8.0",
    "resend": "^6.9.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "playwright": "^1.58.2",
    "postcss": "^8",
    "tailwindcss": "^3.4.1"
  }
}
