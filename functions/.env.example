# Firebase Functions v2 params (defineString) for the Cloud Functions package.
#
# Copy to functions/.env.<projectId> (gitignored) for local emulation. In
# production ci/buildspec-deploy.yml writes that file from the SSM parameter
# /casa-coqui/functions/params right before `firebase deploy --only functions`,
# so the values below must be present there. Secrets (BRIDGE_AWS_ACCESS_KEY_ID,
# BRIDGE_AWS_SECRET_ACCESS_KEY) are defineSecret params set with
# `firebase functions:secrets:set NAME` — never in this file.

# Step Functions state machine the reply-agent bridge starts (required, no default).
REPLY_DRAFT_STATE_MACHINE_ARN=arn:aws:states:us-east-1:<account-id>:stateMachine:casa-coqui-reply-draft

# AWS AppConfig feature-flag source (defaults in index.js match these).
APPCONFIG_APPLICATION=casa-coqui-reply-agent
APPCONFIG_ENVIRONMENT=prod
APPCONFIG_FLAGS_PROFILE=feature-flags
